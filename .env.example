# Neon Postgres connection string (pooled URL recommended for the app)
DATABASE_URL=

# Coach login gate. Defaults are for local/demo only — set these in production.
COACH_USERNAME=Hoyas
COACH_PASSWORD=Sgarlata35

# Optional staff role usernames (comma-separated). All share COACH_PASSWORD unless noted.
# Defaults: COACH_USERNAME → owner, Lars → board, Alum → alumnus preview shell.
HOYA_OWNER_USERNAMES=
HOYA_COACH_USERNAMES=
# Home / For You / Lars Newsflash / Create Event. Cookie: hoya_alum_session.
# Defaults: Lars = board (can write Newsflash and Create Event), Alum = alumnus (read).
# Password falls back to COACH_PASSWORD unless overridden.
HOYA_BOARD_USERNAMES=Lars
HOYA_ALUM_USERNAMES=Alum
# Optional. When set, board usernames use this password instead of COACH_PASSWORD.
HOYA_BOARD_PASSWORD=
HOYA_ALUM_PASSWORD=
HOYA_LOCKER_PASSWORD=

# Optional. Signs the claim/portal contract token (v:1 alumniId/email/name/exp).
# If unset, the secret is derived from the coach credentials.
ALUM_SESSION_SECRET=
# Optional. Signs locker-preview hoya_alum_session ({ role, label, iat }).
HOYA_ALUM_SESSION_SECRET=
# Optional fallback for messages access tokens.
ALUMNI_SESSION_SECRET=

# Alumni messages access code (sets a preview hoya_alum_session). Not Register myself.
HOYA_ALUM_ACCESS_CODE=HoyaSaxa

# Optional. When all three are set, Text blast sends via Twilio.
# Without them the in-app flow still prepares the group and opens Messages / copy.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional. When EMAIL_FROM plus one API key are set, Email blast sends from the app.
# Prefer Resend. SendGrid is the fallback provider. Without them the flow uses mailto / copy.
EMAIL_FROM=
# Optional. When set, alumni replies go here (Gmail OK). From must stay on a verified Resend domain.
EMAIL_REPLY_TO=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional. GUHoyas.com football roster years re-applied after each Data Sync apply.
# Defaults: earliest archived roster year (2003) through the current calendar year.
GUHOYAS_ROSTER_YEARS_FROM=
GUHOYAS_ROSTER_YEARS_TO=

# Optional Find My Alum geocoding (defaults to US city/state centroids — no API key).
# GEOCODE_PROVIDER=centroids|nominatim|hybrid
# GEOCODE_PROVIDER=centroids
# Identifies this app to Nominatim when provider is nominatim or hybrid.
# GEOCODE_USER_AGENT=GeorgetownAlumMap/1.0 (contact: you@example.com)
